# ---------------------------------------------------------------------------
# Rust core worker configuration
#
# Copy to `.env` and adjust, or export the variables in your process manager.
# Every address is a real, resolvable address: when the worker runs on a
# different host than the Python processor, point PY_INGEST_ADDR and
# PY_RENDER_URL at that host instead of 127.0.0.1.
# ---------------------------------------------------------------------------

# --- Network ---------------------------------------------------------------
# Where the worker listens for jobs. Use 0.0.0.0 to accept connections from
# another host (a hosted gateway, for example).
CORE_BIND_ADDR=0.0.0.0:59080

# Where the worker pushes the raw HTML packets. This is the Python processor.
PY_INGEST_ADDR=127.0.0.1:59081

# Where the Python processor serves its results API (used for health checks).
PY_RESULTS_ADDR=127.0.0.1:59082

# The Python endpoint that renders pages with a real browser. The worker calls
# it when a page needs JavaScript or presents an anti-bot challenge.
PY_RENDER_URL=http://127.0.0.1:59082/render

# --- Capacity --------------------------------------------------------------
CORE_WORKERS=64
CORE_QUEUE_CAPACITY=2048
CORE_MAX_URLS_PER_JOB=500
CORE_MAX_HTML_BYTES=5242880

# --- Timing ----------------------------------------------------------------
CORE_REQUEST_TIMEOUT_SECS=10
CORE_CONNECT_TIMEOUT_SECS=5
CORE_MAX_RETRIES=3
CORE_BACKOFF_BASE_MS=250
CORE_BACKOFF_MAX_MS=8000
CORE_STATS_WINDOW_SECS=3600

# --- Stealth ---------------------------------------------------------------
# Rotate the User-Agent per request from a pool of real browsers.
CORE_ROTATE_UA=true
CORE_USER_AGENT=Scrapeworks/0.4 (+https://example.com/bot)

# Rotating residential proxies, comma separated. SOCKS5 and HTTP are both
# supported. Leave empty to connect directly.
# PROXY_LIST=http://user:pass@host1:8000,socks5://user:pass@host2:1080

# Use a genuine browser TLS/HTTP2 fingerprint (Chrome, Firefox, Safari, Edge).
# Requires a binary built with `--features tls-impersonate`.
CORE_TLS_IMPERSONATE=false

# --- Hybrid fetch ----------------------------------------------------------
# Escalate to the headless browser when the cheap HTTP fetch is not enough.
CORE_BROWSER_FALLBACK=true
CORE_MIN_BODY_BYTES=512
CORE_ESCALATE_ON_CHALLENGE=true
CORE_RENDER_TIMEOUT_SECS=45

# Keep one cookie jar per job so a crawl behaves like a single browser session.
CORE_PERSIST_COOKIES=true

# --- Recursive crawl --------------------------------------------------------
# 0 = no link following. The gateway can raise this per request.
CORE_CRAWL_DEPTH=0
# Hard page budget per crawl tree.
CORE_CRAWL_MAX_PAGES=50
# Maximum links followed from a single page.
CORE_CRAWL_MAX_LINKS_PER_PAGE=25
# Follow links that point at another host. Set to false to stay on one site.
CORE_CRAWL_ANY_HOST=true

# --- Logging ---------------------------------------------------------------
RUST_LOG=info
